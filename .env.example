# ── Copy to .env and fill in. Never commit .env. ─────────────────────────────

# Telephony (Twilio) — buy one number, paste its SID/token here
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Voice engine ─────────────────────────────────────────────────────────────
# cascaded = Deepgram + GPT-4o + Cartesia (cheapest, ~$0.05-0.08/min)
# realtime = speech-to-speech, one model (lower latency, more natural)
VOICE_MODE=cascaded
# If VOICE_MODE=realtime, choose the provider:
#   grok   → xAI Grok Voice  (~$0.05/min, cheapest S2S)  → needs XAI_API_KEY
#   openai → OpenAI Realtime (gpt-realtime-2, pricier)   → needs OPENAI_API_KEY
REALTIME_PROVIDER=grok
GROK_VOICE=Ara            # Ara, Rex, Sal, Eve, or Leo

# AI services (fill the ones your mode needs)
OPENAI_API_KEY=           # cascaded LLM, OpenAI realtime, AND knowledge-base embeddings
XAI_API_KEY=              # Grok realtime only
DEEPGRAM_API_KEY=         # cascaded STT only
CARTESIA_API_KEY=         # cascaded TTS only
# ELEVENLABS_API_KEY=     # only if you switch TTS to ElevenLabs in bot.py

# ── Multi-tenant (optional) ──────────────────────────────────────────────────
# Set DATABASE_URL to turn ON multi-tenant: tenants/leads/calls/RAG in Postgres.
# Leave blank to run single-tenant from this .env (the demo). Use your Neon DB.
DATABASE_URL=
# (OPENAI_API_KEY above is also used to embed the knowledge base.)

# Public hostname WITHOUT protocol. In dev this is your ngrok domain, e.g.
#   abcd-1234.ngrok-free.app
# In prod it's your deployed host, e.g. voice.hvrmediahouse.com
PUBLIC_HOST=

# Optional: a business name the agent represents (used in the script)
BUSINESS_NAME=The Reid Group
# Optional: number to transfer hot leads / escalations to (a human's phone)
TRANSFER_PHONE_NUMBER=

# Optional: Cal.com API key for real calendar booking (else booking is stubbed)
CAL_API_KEY=
